# Discord Bot Configuration
# ========================

# REQUIRED: Discord Bot Token
# Get it from: https://discord.com/developers/applications → Bot → Token
DISCORD_TOKEN=your_bot_token_here

# OPTIONAL: Discord Application ID (Client ID)
# If omitted, deploy-commands.js fetches it from the Discord API using your token.
# Get it from: https://discord.com/developers/applications → General Information → Application ID
DISCORD_CLIENT_ID=your_application_id_here

# OPTIONAL: Server (Guild) ID for instant slash-command registration
# If set, /commands appear in 1-2 minutes on that server only.
# If omitted, commands register globally (can take up to 1 hour to appear).
GUILD_ID=your_server_id_here

# Lavalink Configuration (Primary Node)
# =======================================
# The bot automatically discovers additional public Lavalink v4 nodes for redundancy.
# This is your primary/preferred node. If it fails, the bot falls over to others automatically.
#
# DEPLOY EN DOCKER (VM Oracle): el nodo primario es tu Lavalink propio, accesible
# por el nombre de servicio de docker-compose. Es texto plano dentro de la red
# interna (no TLS), así que LAVALINK_SECURE=false.
#
#   LAVALINK_URL=lavalink:2333
#   LAVALINK_PASSWORD=<el mismo password fuerte que usa el contenedor lavalink>
#   LAVALINK_SECURE=false
#
# DESARROLLO LOCAL sin Lavalink propio: podés apuntar a un nodo público v4 SSL,
# por ejemplo lavalink-v4.triniumhost.com:443 (password: free, SECURE=true).
# En cualquier caso el bot autodescubre nodos públicos como fallback.

LAVALINK_URL=lavalink:2333
LAVALINK_PASSWORD=changeme_use_a_strong_password
LAVALINK_SECURE=false
